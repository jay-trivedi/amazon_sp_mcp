{
  "name": "amazon-seller-central-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server for Amazon Seller Central - Access sales data, inventory, returns, and reports through the Amazon SP-API",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node build/index.js",
    "watch": "tsc --watch",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/e2e",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --ci --coverage --maxWorkers=2",
    "test:debug": "node --experimental-vm-modules --inspect-brk node_modules/jest/bin/jest.js --runInBand",
    "test:manual-auth": "tsx scripts/test-auth.ts",
    "type-check": "tsc --noEmit",
    "type-check:fast": "tsgo --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "rm -rf build coverage"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "amazon",
    "seller-central",
    "sp-api",
    "amazon-sp-api",
    "typescript",
    "ai-agent",
    "claude"
  ],
  "author": "Jay Trivedi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jay-trivedi/amazon_sp_mcp.git"
  },
  "bugs": {
    "url": "https://github.com/jay-trivedi/amazon_sp_mcp/issues"
  },
  "homepage": "https://github.com/jay-trivedi/amazon_sp_mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "aws4": "^1.13.2",
    "axios": "^1.7.9",
    "dotenv": "^17.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws4": "^1.11.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.0",
    "@typescript/native-preview": "7.0.0-dev.20260619.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "nock": "^14.0.15",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
